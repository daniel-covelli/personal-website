generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Conversation {
  id        String    @id @default(cuid())
  sessionId String    @map("session_id")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  messages  Message[]

  @@index([sessionId])
  @@map("conversations")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String       @map("conversation_id")
  role           String
  content        String       @db.Text
  createdAt      DateTime     @default(now()) @map("created_at")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("messages")
}

model ResumeContent {
  id        String   @id @default("singleton")
  content   Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("resume_content")
}

// ============================================
// Structured Resume Tables
// ============================================

model Header {
  id        String   @id @default("singleton")
  name      String
  title     String
  bio       String   @db.Text
  imageUrl  String   @default("") @map("image_url")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("header")
}

model Experience {
  id          String   @id @default(cuid())
  jobTitle    String   @map("job_title")
  company     String
  startDate   String   @map("start_date")
  endDate     String   @map("end_date")
  description String?  @db.Text
  bullets     String[]
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("experiences")
}

model Education {
  id          String   @id @default(cuid())
  degree      String
  institution String
  startDate   String   @map("start_date")
  endDate     String   @map("end_date")
  description String?  @db.Text
  bullets     String[]
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("education")
}

model SkillCategory {
  id        String   @id @default(cuid())
  name      String
  items     String[]
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("skill_categories")
}

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  bullets     String[]
  githubUrl   String?  @map("github_url")
  liveUrl     String?  @map("live_url")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("projects")
}

model Contact {
  id        String   @id @default("singleton")
  email     String   @default("")
  phone     String   @default("")
  location  String   @default("")
  linkedin  String   @default("")
  github    String   @default("")
  twitter   String   @default("")
  website   String   @default("")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("contact")
}

// DEPRECATED — superseded by ChatModel below (multi-provider catalog). Kept as
// a dead table only to avoid schema/DB drift; a follow-up migration drops it
// once the multi-model code is deployed. Nothing reads it anymore.
model ChatConfig {
  id        String   @id @default("singleton")
  models    String[]
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("chat_config")
}

// Catalog of chat models across providers. Each row is one fallback/selectable
// model. The enabled rows ordered by sortOrder form the resilience fallback
// chain; userSelectable rows appear in the visitor-facing picker.
//
//   provider — serving adapter + API key: anthropic | openai | google | groq
//   lab      — brand for logo/name:        anthropic | openai | google | meta | mistral
//
// provider != lab: an OpenAI-compatible host (e.g. groq) can serve Meta (llama)
// and Mistral (mixtral) models. See lib/providers/ for the adapters and
// components/chat/labs for the lab logo/name registry.
model ChatModel {
  id             String   @id @default(cuid())
  provider       String
  lab            String
  modelId        String   @map("model_id")
  label          String
  enabled        Boolean  @default(true)
  userSelectable Boolean  @default(false) @map("user_selectable")
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("chat_models")
}
