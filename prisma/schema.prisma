generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Conversation {
  id        String    @id @default(cuid())
  sessionId String    @map("session_id")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  messages  Message[]

  @@index([sessionId])
  @@map("conversations")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String       @map("conversation_id")
  role           String
  content        String       @db.Text
  createdAt      DateTime     @default(now()) @map("created_at")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("messages")
}

model ResumeContent {
  id        String   @id @default("singleton")
  content   Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("resume_content")
}

// ============================================
// Structured Resume Tables
// ============================================

model Header {
  id        String   @id @default("singleton")
  name      String
  title     String
  bio       String   @db.Text
  imageUrl  String   @default("") @map("image_url")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("header")
}

model Experience {
  id          String   @id @default(cuid())
  jobTitle    String   @map("job_title")
  company     String
  startDate   String   @map("start_date")
  endDate     String   @map("end_date")
  description String?  @db.Text
  bullets     String[]
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("experiences")
}

model Education {
  id          String   @id @default(cuid())
  degree      String
  institution String
  startDate   String   @map("start_date")
  endDate     String   @map("end_date")
  description String?  @db.Text
  bullets     String[]
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("education")
}

model SkillCategory {
  id        String   @id @default(cuid())
  name      String
  items     String[]
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("skill_categories")
}

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  bullets     String[]
  githubUrl   String?  @map("github_url")
  liveUrl     String?  @map("live_url")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("projects")
}

model Contact {
  id        String   @id @default("singleton")
  email     String   @default("")
  phone     String   @default("")
  location  String   @default("")
  linkedin  String   @default("")
  github    String   @default("")
  twitter   String   @default("")
  website   String   @default("")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("contact")
}

// A long-form article/blog post. The body is Markdown (GFM + fenced code +
// ```mermaid diagrams), rendered on /articles/[slug]. The chat assistant is
// given a lightweight index of published articles in its system prompt and can
// pull a full body on demand via the read_article tool (see app/api/chat).
model Article {
  id             String    @id @default(cuid())
  slug           String    @unique
  title          String
  summary        String    @db.Text
  body           String    @db.Text
  headerImageUrl String    @default("") @map("header_image_url")
  tags           String[]
  placement      String    @default("")
  bannerTitle    String    @default("") @map("banner_title")
  bannerSubtitle String    @default("") @map("banner_subtitle")
  published      Boolean   @default(false)
  publishedAt    DateTime? @map("published_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([published, publishedAt])
  @@map("articles")
}

// Ordered list of Claude model IDs the chat assistant tries, in order, until
// one succeeds. Stored here (rather than hardcoded) so a model retirement can
// be fixed from /admin without a code change or redeploy. Singleton row.
model ChatConfig {
  id           String   @id @default("singleton")
  models       String[]
  // Optional override for the chat assistant's system-prompt template, editable
  // from /admin. NULL means "use the built-in default" (lib/chat.ts). May contain
  // {{NAME}}/{{TITLE}}/{{RESUME}} placeholders filled at request time.
  systemPrompt String?  @db.Text @map("system_prompt")
  // Optional override for the opening-message instruction (also a Liquid template,
  // editable from /admin). NULL means "use the built-in default" (lib/chat.ts).
  // Rendered against the same resume context and sent as the user turn that asks
  // the model to write the first message.
  greetingPrompt String? @db.Text @map("greeting_prompt")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("chat_config")
}

// ============================================
// First-party analytics (see lib/analytics.ts)
// ============================================

// One tracked pageview, written by POST /api/track (production only; see
// lib/capture.ts). referrer/utm_source/user_agent are stored RAW: traffic-source
// and bot classification happen at read time (lib/traffic-sources.ts) so those
// lists can evolve and old rows reclassify for free. Deliberately anonymous —
// no IP is ever stored; geo comes from Vercel's edge headers. session_id is the
// same chat_session_id cookie the chat uses, which is what lets the admin
// dashboard join a visitor's pageviews to their conversation. Never purged by
// the cleanup cron: rows are small and per-day history should be unlimited.
model PageView {
  id        String   @id @default(cuid())
  sessionId String   @map("session_id")
  path      String
  referrer  String   @default("")
  utmSource String   @default("") @map("utm_source")
  country   String   @default("")
  region    String   @default("")
  city      String   @default("")
  device    String   @default("")
  userAgent String   @default("") @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([sessionId])
  @@map("page_views")
}

// Non-pageview visitor events — currently only 'resume_download', written by
// /api/pdf. Generic type column so future events are additive data, not DDL.
// Carries its own country/user_agent so a download-only session (someone
// hitting /api/pdf from an emailed link) still renders a journey with
// geo/device in the admin dashboard.
model SiteEvent {
  id        String   @id @default(cuid())
  sessionId String   @map("session_id")
  type      String
  country   String   @default("")
  userAgent String   @default("") @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([sessionId])
  @@map("site_events")
}
