# Database connection string
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-key-here

# Your domain (set automatically on Vercel)
NEXTAUTH_URL=http://localhost:3000

# Generate password hash with: node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
# Then escape every $ in the hash as \$ — Next's dotenv-expand mangles unescaped $ in
# local .env files, so the login fails. Paste the RAW hash on Vercel (no escaping there).
ADMIN_PASSWORD_HASH=\$2a\$10\$your-bcrypt-hash-here

# Anthropic API key for chat functionality
ANTHROPIC_API_KEY=

# Vercel Blob store token — powers admin image uploads (/api/upload).
# Provisioned automatically when a Blob store is linked to the Vercel project;
# for local uploads, pull it with `vercel env pull`. Uploads return 501 if unset.
BLOB_READ_WRITE_TOKEN=

# Set to 1 to force analytics capture (/api/track pageviews, /api/pdf resume
# downloads) OUTSIDE production, where it otherwise no-ops with a console.log.
# WARNING: local dev and preview deploys share the PRODUCTION database —
# enabling this writes real rows into prod page_views/site_events. Leave unset;
# use only for a deliberate end-to-end test, then delete the rows (pnpm db:studio).
# ANALYTICS_FORCE=
